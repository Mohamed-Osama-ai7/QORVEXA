# Copy to .env and adjust. Names and safe placeholders only; never commit real secrets.
# Primary prefix is QORVEXA_* (legacy FACTORYMIND_* prefix is automatically supported as fallback).

# Backend
QORVEXA_ENVIRONMENT=development
QORVEXA_DATA_DIR=D:/QORVEXA/data
QORVEXA_ARTIFACTS_DIR=D:/QORVEXA/artifacts
QORVEXA_ANOMALY_MODEL_NAME=metropt3-anomaly

# Authentication (OIDC resource server). Protected routes answer 401 until all three are set.
QORVEXA_AUTH_ISSUER=https://idp.example.com/realms/factory
QORVEXA_AUTH_AUDIENCE=qorvexa-api
QORVEXA_AUTH_JWKS_URL=https://idp.example.com/realms/factory/protocol/openid-connect/certs
# QORVEXA_AUTH_JWKS_FILE=D:/QORVEXA/secrets/jwks.json   # air-gapped alternative to the URL
# Single-tenant mode is an explicit opt-in; without it a token with no tenant claim is rejected.
# QORVEXA_SINGLE_TENANT_MODE=true
# QORVEXA_DEFAULT_TENANT_ID=acme          # required by single-tenant mode
# QORVEXA_DATA_SOURCE_TENANT_ID=acme      # tenant that owns the served telemetry/model
#   (defaults to DEFAULT_TENANT_ID in single-tenant mode; with neither set, anomaly and
#   incident data are denied to everyone)
# QORVEXA_ASSET_IDS=["metropt3-apu-1"]
# QORVEXA_DATA_SOURCE_ASSET_ID=metropt3-apu-1   # the one asset the model/dataset describes
# QORVEXA_DATABASE_URL=sqlite:///D:/QORVEXA/data/qorvexa.sqlite3

# Frontend dev server proxy target for /api
QORVEXA_API_URL=http://127.0.0.1:8000
